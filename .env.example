# Rox Neural Orbital Interface - Environment Configuration
# Copy this file to .env.local and customize as needed

# Frontend Configuration
VITE_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend Configuration
PORT=4000
CLIENT_URL=http://localhost:3000
HOST=0.0.0.0

# JWT Authentication
JWT_SECRET=your-jwt-secret-key-change-in-production
PASSWORD_SALT=rox-salt-change-in-production

# AI Provider API Keys (Required for full functionality)
# At least one AI provider must be configured

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Omniroute (Optional local inference)
OMNIROUTER_API_KEY=your-omniroute-key
OMNIROUTER_URL=http://localhost:20128/v1

# FreeLLM (Optional alternative)
FREELLM_API_KEY=your-freellm-key
FREELLM_URL=http://localhost:31415/v1

# Database Configuration (Optional - for production)
DATABASE_URL=file:./data/rox.db?cache=shared
# or for PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/rox

# Google Sheets Integration (Optional)
GOOGLE_SHEETS_CREDENTIALS_PATH=./credentials.json
GOOGLE_SHEETS_SPREADSHEET_ID=your-sheet-id

# Logging & Monitoring
LOG_LEVEL=info
ENABLE_ANALYTICS=false
ANALYTICS_ID=your-analytics-id

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_TIMEOUT_MS=3600000  # 1 hour
REFRESH_TOKEN_EXPIRY_MS=2592000000  # 30 days

# File Upload
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/*,application/pdf,text/*

# Security
ENABLE_CORS=true
CORS_ORIGIN=http://localhost:3000
ENABLE_CONTENT_SECURITY_POLICY=true

# Development Settings
ENABLE_DEBUG_MODE=true
HOT_RELOAD_ENABLED=true
API_DOCS_ENABLED=true

# Monitoring & Health Checks
HEALTH_CHECK_ENDPOINT=/api/health
METRICS_ENDPOINT=/api/metrics
ENABLE_PROMETHEUS_METRICS=false
