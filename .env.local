# Rox Orb UI — Local Environment
# Copy this file to .env.local and fill in your actual values

# AI Providers — Rox tries Omniroute first, then falls back to this provider
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=sk-d656ee33b2d34cb0-381aa9-5acd090f
# OMNIROUTE_MODEL=auto

# FreeLLM API (primary local provider)
FREELLM_BASE_URL=http://127.0.0.1:31415/v1
FREELLM_API_KEY=freellmapi-c6d846374855a302d3b1450673db04d7f34e4546abf036c9
FREELLM_MODEL=auto

# Legacy AI_* keys (for backwards compatibility if no FREELLM_* is set)
AI_BASE_URL=http://127.0.0.1:31415/v1
AI_API_KEY=freellmapi-c6d846374855a302d3b1450673db04d7f34e4546abf036c9
AI_MODEL=auto

# Node
NODE_ENV=development

# Rox ⇄ YouTube Agent bridge
YOUTUBE_AGENT_URL=http://127.0.0.1:3457
