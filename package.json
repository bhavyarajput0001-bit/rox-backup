{
  "name": "rox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --filter @rox/web dev",
    "dev:server": "pnpm --filter @rox/server dev",
    "dev": "pnpm --parallel dev:web dev:server",
    "build:web": "pnpm --filter @rox/web build",
    "build:server": "pnpm --filter @rox/server build",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
